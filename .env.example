# Copy to .env at the project root. Exported environment variables take precedence.
# Used only for the initial administrator. Blank password generates private local credentials.
ADMIN_EMAIL=admin@career.local
ADMIN_PASSWORD=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
PROFILE_MODEL=qwen3:8b
JD_MODEL=qwen3:8b
UPDATE_MODEL=qwen3:8b
CV_MODEL=qwen3:8b
# Optional separate bullet-writing model; empty falls back to CV_MODEL.
WRITER_MODEL=kltn-writer-8b-unsloth:latest
# Blank inherits WRITER_MODEL for wording refinement, including source checks.
REFINE_MODEL=
# Separate semantic review of new paraphrases; not used to override hard fact checks.
VERIFIER_MODEL=qwen3:8b
FORM_CV_MODEL=qwen3:8b
ASSISTANT_MODEL=qwen3:8b
INTERVIEW_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
LLM_TIMEOUT_SECONDS=600
LLM_CONTEXT_LENGTH=16384
# Optional Groq routing. Keep empty to use Ollama for all tasks.
# Put the real key in .env or export it in the backend process environment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional per-task overrides; blank inherits GROQ_MODEL.
GROQ_ASSISTANT_MODEL=openai/gpt-oss-20b
GROQ_PROFILE_MODEL=openai/gpt-oss-120b
GROQ_UPDATE_MODEL=openai/gpt-oss-20b
GROQ_TASKS=
# Example: GROQ_TASKS=profile,assistant,update
# Keep writer/refine local to use the fine-tuned Qwen8B model.
GROQ_TIMEOUT_SECONDS=120
PROFILE_STORAGE_DIR=backend/storage/master_profiles
# PostgreSQL is required for durable drafts, AI tasks and interviews.
KLTN_STORAGE=postgres
KLTN_WORKER_ENABLED=1
WORKSPACE_OWNER_ID=local-demo
KLTN_ASSET_STORAGE=backend/storage/assets
# Optional: custom Chromium executable; otherwise use Playwright headless shell.
# CV_CHROME_BINARY=/absolute/path/to/chromium
# docker-compose.yml exposes PostgreSQL on port 55432.
DATABASE_URL=postgresql://kltn_demo:local-preflight-only@127.0.0.1:55432/kltn_demo

# Cloudflare Workers AI. Fill credentials, then enable the desired tasks.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b
# Optional stronger CV review; blank inherits CLOUDFLARE_MODEL.
CLOUDFLARE_CV_MODEL=
# Example stronger model, if needed: @cf/qwen/qwen3.8-27b
CLOUDFLARE_TASKS=
# Example: CLOUDFLARE_TASKS=jd,interview,cv,verifier
# Never put writer/refine here: they use the local fine-tuned model.
CLOUDFLARE_TIMEOUT_SECONDS=120
CLOUDFLARE_MAX_OUTPUT_TOKENS=2048
# Set to 1 when the application is served over HTTPS.
AUTH_COOKIE_SECURE=0
