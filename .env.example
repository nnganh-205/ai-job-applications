# Example only. Application reads exported process variables; never sources .env automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
PROFILE_MODEL=qwen3:4b
JD_MODEL=qwen3:4b
UPDATE_MODEL=qwen3:4b
CV_MODEL=qwen3:4b
# Optional separate bullet-writing model; empty falls back to CV_MODEL.
WRITER_MODEL=kltn-writer-8b-unsloth:latest
# Separate semantic review of new paraphrases; not used to override hard fact checks.
VERIFIER_MODEL=qwen3:8b
FORM_CV_MODEL=qwen3:4b
ASSISTANT_MODEL=qwen3:4b
INTERVIEW_MODEL=qwen3:4b
EMBEDDING_MODEL=bge-m3
LLM_TIMEOUT_SECONDS=600
LLM_CONTEXT_LENGTH=16384
PROFILE_STORAGE_DIR=backend/storage/master_profiles
# PostgreSQL is required for durable drafts, AI tasks and interviews.
KLTN_STORAGE=postgres
KLTN_WORKER_ENABLED=1
WORKSPACE_OWNER_ID=local-demo
KLTN_ASSET_STORAGE=backend/storage/assets
# Optional: custom Chromium executable; otherwise use Playwright headless shell.
# CV_CHROME_BINARY=/absolute/path/to/chromium
# Local preflight uses port 55432.
DATABASE_URL=postgresql://kltn_demo:local-preflight-only@127.0.0.1:55432/kltn_demo
