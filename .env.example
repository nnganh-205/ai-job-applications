# Example only. Application reads exported process variables; never sources .env automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
PROFILE_MODEL=qwen3:4b
JD_MODEL=qwen3:4b
UPDATE_MODEL=qwen3:4b
CV_MODEL=qwen3:4b
EMBEDDING_MODEL=bge-m3
LLM_TIMEOUT_SECONDS=600
LLM_CONTEXT_LENGTH=16384
PROFILE_STORAGE_DIR=backend/storage/master_profiles
# Database persistence is implemented on day 3. Local preflight uses port 55432.
DATABASE_URL=postgresql://kltn_demo:local-preflight-only@127.0.0.1:55432/kltn_demo
